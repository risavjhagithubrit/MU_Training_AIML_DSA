int main(){
    int n;
    cin>>n;

    int sum = 0;
    for(int i=1; i<=n/2; i++){
        if(n%i == 0){       
            sum += i;
        }
    }
    if(sum == n){
        cout << "true";
    }
    else{
        cout << "false";
    }
    return 0;
}

// 4. Strong Number

/* Input  : n = 145
Output : Yes
Sum of digit factorials = 1! + 4! + 5!
                        = 1 + 24 + 120
                        = 145
Input :  n = 534
Output : No

*/

 #include<bits/stdc++.h>
using namespace std;

int isStrong(int n){
    int sum = 0;
    int original = n;
    int fact[n]{1,1};
    for(int i=2; i<n; i++){
        fact[i] = i*fact[i-1];
    }
    while(n>0){
        sum += fact[n%10];
        n/=10;
    }
    return sum == original;
}
int main(){
    int n;
    cin>>n;


   cout << isStrong(n);
    return 0;
}

