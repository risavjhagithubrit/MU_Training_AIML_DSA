// 1. To Check Leap Year

// Approach 1: Basic English Code(If-else)

#include <iostream>
using namespace std;

int main()
{
    int year;

    cout << "Enter Year : ";
    cin >> year;

    if(year % 400 == 0)
    {
        cout << "Leap Year";
    }
    else if(year % 100 == 0)
    {
        cout << "Not a Leap Year";
    }
    else if(year % 4 == 0)
    {
        cout << "Leap Year";
    }
    else
    {
        cout << "Not a Leap Year";
    }

    return 0;
}

