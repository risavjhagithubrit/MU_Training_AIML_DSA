/* Max Sum Subarray of size K */

=> Code: 

int maxSubarraySum(vector<int>& arr, int k) {
        // code here
        int sum = 0, n = arr.size();
        for(int i=0; i<k; i++){
            sum += arr[i];
        }
        int maxi = sum;
        for(int i=k; i<n; i++){
            sum += arr[i]-arr[i-k];
            maxi = max(sum, maxi);
        }
        return maxi;
    }

=> Complexity
Time: 
O(n) { O(k) + O(n-k) = O(n) }
Space:
O(1)


/* Maximum Average Subarray I */

=> Code:

double findMaxAverage(vector<int>& nums, int k) {
        int sum =0, n = nums.size();
        for(int i=0; i<k; i++){
            sum += nums[i];
        }
        int maxi = sum;
        for(int i=k; i<n; i++){
            sum += nums[i]-nums[i-k];
            maxi = max(sum, maxi);
        }
        return (double)maxi/k;
    }

=> Complexity
Time: 
O(n) { O(k) + O(n-k) = O(n) }
Space:
O(1)

