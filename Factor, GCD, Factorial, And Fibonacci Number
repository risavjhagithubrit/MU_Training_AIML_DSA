/* APPROACH 2--*/
#include<bits/stdc++.h>
using namespace std;

int gcd(int a, int b){
 if(a== 0) return b;
 if(b == 0) return a;

 if(a == b) return a;

 if(a>b) {
    return gcd(a-b, b);
 } 
    return gcd(a, b-a);


}

int main(){
    int a, b;
    cin>>a>>b;

   cout << gcd(a,b);


    return 0;
}

// 3. Factorial Of Number

/* T.C: O(N)
    S.C: O(1)*/

#include<bits/stdc++.h>
using namespace std;

int factorial(int n){

    int res = 1;
    for(int i = 2; i<=n; i++){
        res *= i;
    }
    return res;
}

int main(){
    int n;
    cin>>n;

    cout << "factorial of " << n << " is " << factorial(n);

    return 0;
}

// 4. Fibonacci Of Number


#include<bits/stdc++.h>
using namespace std;

/* RECURSION
    T.C: O(2^N)
    S.C: O(N)*/

int nthfibonacci(int n){

    if(n<=1) return n;

    return nthfibonacci(n-1)+nthfibonacci(n-2);
}

