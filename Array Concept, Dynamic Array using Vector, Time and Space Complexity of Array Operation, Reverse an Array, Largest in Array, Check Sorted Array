//  How to initialize entire array through any value

#include<iostream>
using namespace std;
int main(){
    int a[10] = {0};
    int b[10] = {5};
    int c[10];
    int d[10] = {3};
     for(int i = 0;i<10;i++){
       c[i] = 5;
    }
    cout<<"Elements of array a: ";
    for(int i=0;i<10;i++){
        cout<< a[i] <<" ";
    }
    cout<<"\n";
    cout<<"Elements of array b: ";
    for(int i = 0;i<10;i++){
        cout<<b[i] <<" ";
    }
    cout<<"\n";
    cout<<"Elements of array c: ";
    for(int i=0;i<10;i++){
        cout<<c[i]<<" ";
    }
    cout<<"\n";
    cout<<"Elements of array d: ";
    // Undefined Behavior (UB)
    for(int i=0;i<20;i++){
        cout<<d[i]<<" ";
        // cout<<"\n";
    }
    return 0;
}

