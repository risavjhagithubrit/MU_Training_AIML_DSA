=> Remove Duplicates from Sorted Array

-> Code: 
class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        int count=0, n=nums.size();
        for(int i=0; i<n; i++){
            if(i<n-1 && nums[i]==nums[i+1]){
                continue;
            }
            else{
                nums[count] = nums[i];
                count++;
            }
        }
        return count;
    }
};

-> Complexity:
Time Complexity: O(n)
Space Complexity: O(1)


=> Sort Colors

-> Code: 

class Solution {
public:
    void sortColors(vector<int>& nums) {
        int i = 0, j=0, k=nums.size()-1;

        while(i<=k){
            if(nums[i]==0){
                swap(nums[i], nums[j]);
                i++;
                j++;
            }
            else if(nums[i] == 1){
                swap(nums[i], nums[j]);
                i++;
            }
            else{
                swap(nums[i], nums[k]);
                k--;
            }
        }
    }
};


-> Complexity:
Time Complexity: O(n)
Space Complexity: O(1)

