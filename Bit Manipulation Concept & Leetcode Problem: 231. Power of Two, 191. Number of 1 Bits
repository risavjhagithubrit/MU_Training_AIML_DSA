// 191. Number of 1 Bits

// Approach 1: 

int count = 0;
        while(n>0){
            count++;
            n = n & (n-1);
        }
        return count;


// Approach 2:

 int count = 0;
        while(n>0){
            if(n&1){
                count++;
            } 
            n=n>>1;
        }
        return count;
