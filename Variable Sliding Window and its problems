Example
Longest Subarray Sum ≤ K
int left=0;

int sum=0;

int ans=0;

for(int right=0;right<n;right++){

    sum+=arr[right];

    while(sum>K){

        sum-=arr[left];

        left++;
    }

    ans=max(ans,right-left+1);
}

