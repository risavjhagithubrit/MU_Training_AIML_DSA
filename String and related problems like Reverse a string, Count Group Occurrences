MODULE 2 — String Traversal & Manipulation
2.1 Traversing a String
Normal loop:
for(int i = 0; i < s.length(); i++){
   cout << s[i];
}
Range-based loop:
for(char ch : s){
   cout << ch;
}

2.2 Reverse a String
Two Pointer Approach & other approaches discussed.
int i = 0;
int j = s.length() - 1;

while(i < j){
   swap(s[i], s[j]);
   i++;
   j--;
}
Complexity
Time  = O(n)
Space = O(1)

=> Problem: Count Group Occurrences

class Solution {
  public:
    int getCount(string s, int k) {
        // code here
        unordered_map<char, int> mp;
        mp[s[0]] = 1;
        for(int i=1; i<s.size(); i++){
            if(s[i] != s[i-1]){
                mp[s[i]]++;
            }
        }
        
        int val=0;
        for(auto it : mp){
            if(it.second == k){
                val++;
            }
        }
        return val;
    }
};
