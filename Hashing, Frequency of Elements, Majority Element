13. Count Distinct Elements
Example:
arr = [1, 2, 2, 3, 3, 3, 4]
Distinct elements:
1, 2, 3, 4
Answer:
4
Using hashing:
unordered_set<int> st;

for (int x : arr) {
   st.insert(x);
}

cout << st.size();
Remember:
unordered_set
Stores only keys:
{1, 2, 3, 4}
unordered_map
Stores key-value pairs:
1 → 1
2 → 2
3 → 3
4 → 1

=> Problem: Frequency of Elements

=> Code:

class Solution {
  public:
    vector<vector<int>> countFreq(vector<int>& arr) {
        // code here
        map<int,int> freqMap;
        for(int element : arr){
            freqMap[element]++;
        }
        vector<vector<int>> result;
        for(auto const& pair : freqMap){
            result.push_back({pair.first, pair.second});
        }
        return result;
    }
};

=> Problem: Majority Element

=> Code: 
class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int count=0, candidate=0;
        for(int num: nums){
        if(count==0){
            candidate =num;
        }
        if(num==candidate){
            count++;
        }
        else count--;
        }
        return candidate;

    }
};
