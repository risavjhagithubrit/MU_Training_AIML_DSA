// 2. Reverse Number

// T.C: O(logn), S.C: O(1)

#include<bits/stdc++.h>
using namespace std;

int reverseDigit(int num){
    int rev_num = 0;
    while(num > 0){
    rev_num = rev_num * 10 + num % 10;
    num /= 10;

    }

    return rev_num;
}


int main(){
    int num;
    cin>>num;

    cout << reverseDigit(num);


    return 0;
}




