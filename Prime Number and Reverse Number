// 1. Prime Number

#include<bits/stdc++.h>
using namespace std;

// Bruteforce Approach: T.C: O(n), S.C: O(1) 
int isPrime(int n){
    if(n<=1) return false;
    for(int i = 2; i<n; i++)
        if(n%i == 0) return false;
        
        
    return true;
    

}

void prime(int n){
    for(int i = 2; i<=n; i++){
        if(isPrime(i))
            cout << i << " ";
    }
}

